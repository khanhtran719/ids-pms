{
  "name": "@project-ql/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "nx serve web",
    "start:api": "nx serve api",
    "start:web": "nx serve web",
    "build": "CI=true NX_TASKS_RUNNER_DYNAMIC_OUTPUT=false nx run-many -t build --projects=api,web",
    "lint": "nx run-many -t lint --projects=api,web,api-contracts,api-e2e,web-e2e",
    "test": "nx run-many -t test --projects=api,web",
    "test:coverage": "nx run-many -t test --projects=api,web --coverage --runInBand",
    "test:coverage:api": "nx test api --coverage --runInBand",
    "test:coverage:web": "nx test web --coverage --runInBand",
    "test:e2e": "nx e2e api-e2e --runInBand && nx e2e web-e2e",
    "ai:session:start": "node tools/ai/session-log.mjs start",
    "ai:session:log": "node tools/ai/session-log.mjs note",
    "ai:session:end": "node tools/ai/session-log.mjs end"
  },
  "private": true,
