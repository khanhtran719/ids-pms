# Copy to .env.uat on the UAT server. Never commit the real file.
UAT_HTTP_PORT=8080
WEB_ORIGIN=https://uat.example.com
MONGODB_DATABASE=project_ql_uat

# Docker Hub images. Use an immutable release tag when sharing UAT externally.
DOCKER_API_IMAGE=khanhtrn2608/ids-pms-api
DOCKER_WEB_IMAGE=khanhtrn2608/ids-pms-web
DOCKER_IMAGE_TAG=uat
DOCKER_PLATFORM=linux/amd64

API_PORT=3000
FILE_STORAGE_ROOT=/app/storage/uploads
MAX_UPLOAD_SIZE_MB=20
JSON_BODY_LIMIT=100kb
URLENCODED_PARAMETER_LIMIT=100
ENABLE_SWAGGER=false
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
TRUST_PROXY_HOPS=1
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
AUTH_COOKIE_SECURE=true

# The API creates this administrator once. Use a strong UAT-only password.
SEED_ADMIN_EMAIL=uat-admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-uat-password
SEED_ADMIN_DISPLAY_NAME=UAT Administrator

# Must exactly match seed:<MONGODB_DATABASE> or the demo seed exits safely.
DEMO_SEED_CONFIRM=seed:project_ql_uat
